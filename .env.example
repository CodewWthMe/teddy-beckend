# ================================================
# Copy this file to .env for local development
# On Render: add these in Environment Variables tab
# DO NOT commit .env to GitHub
# ================================================

# ── JWT Secret (make this long and random!) ──────
JWT_SECRET=replace_with_a_very_long_random_string_at_least_32_chars

# ── MongoDB Atlas connection string ──────────────
# Get this from: MongoDB Atlas → Connect → Drivers
# Format: mongodb+srv://username:password@cluster.mongodb.net/curled-macrame
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/curled-macrame

# ── Cloudinary (free image hosting) ─────────────
# Sign up free at cloudinary.com
# Then go to: Dashboard → copy these 3 values
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Port (Render sets this automatically) ────────
PORT=3000
